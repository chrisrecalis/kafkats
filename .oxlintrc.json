{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"categories": {
		"correctness": "error"
	},
	"env": {
		"node": true,
		"es2021": true
	},
	"rules": {
		"no-unassigned-vars": "off",
		"unicorn/no-new-array": "off",
		"unicorn/no-useless-length-check": "off",
		"no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_"
			}
		]
	},
	"overrides": [
		{
			"files": ["packages/*/tests/**/*.ts"],
			"env": {
				"vitest": true
			}
		}
	],
	"ignorePatterns": ["**/dist/**", "**/node_modules/**", "**/*.tsbuildinfo", "**/.vitepress/cache/**"]
}
