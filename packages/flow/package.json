{
	"name": "@kafkats/flow",
	"private": false,
	"version": "0.11.1",
	"description": "Flow-level APIs built on top of @kafkats/client.",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./testing": {
			"import": {
				"types": "./dist/testing.d.ts",
				"default": "./dist/testing.js"
			},
			"require": {
				"types": "./dist/testing.d.cts",
				"default": "./dist/testing.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"license": "MIT",
	"keywords": [
		"kafka",
		"streams",
		"streaming",
		"dsl",
		"ktable",
		"kstream",
		"aggregation",
		"windowing",
		"typescript"
	],
	"homepage": "https://chrisrecalis.github.io/kafkats",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chrisrecalis/kafkats.git",
		"directory": "packages/flow"
	},
	"bugs": {
		"url": "https://github.com/chrisrecalis/kafkats/issues"
	},
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "pnpm clean && tsdown --config-loader native",
		"test": "vitest run tests",
		"test:integration": "vitest run -c vitest.integration.config.ts",
		"test:unit": "vitest run tests/unit",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"clean": "rm -rf dist",
		"prepack": "pnpm -w turbo run build --filter=$npm_package_name"
	},
	"dependencies": {
		"@kafkats/client": "workspace:^"
	},
	"devDependencies": {
		"@testcontainers/kafka": "^11.8.1",
		"@types/node": "^24.10.1",
		"testcontainers": "^11.8.1",
		"tsdown": "^0.22.14",
		"tsx": "^4.20.6",
		"typescript": "^7.0.2",
		"vitest": "^4.0.12"
	}
}
