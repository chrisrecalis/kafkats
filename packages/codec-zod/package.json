{
	"name": "@kafkats/codec-zod",
	"private": false,
	"version": "0.10.0",
	"description": "Zod codec helpers for @kafkats/client.",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"license": "MIT",
	"keywords": [
		"kafka",
		"zod",
		"codec",
		"validation",
		"schema",
		"serialization",
		"typescript"
	],
	"homepage": "https://chrisrecalis.github.io/kafkats",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chrisrecalis/kafkats.git",
		"directory": "packages/codec-zod"
	},
	"bugs": {
		"url": "https://github.com/chrisrecalis/kafkats/issues"
	},
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "pnpm clean && tsdown --config-loader native",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"clean": "rm -rf dist",
		"prepack": "pnpm -w turbo run build --filter=$npm_package_name",
		"test": "vitest run tests"
	},
	"dependencies": {
		"@kafkats/client": "workspace:^"
	},
	"peerDependencies": {
		"zod": "^4.0.0"
	},
	"devDependencies": {
		"@types/node": "^24.10.1",
		"tsdown": "^0.22.14",
		"typescript": "^7.0.2",
		"zod": "^4.1.11",
		"vitest": "^4.0.12"
	}
}
