{
	"name": "@kafkats/client",
	"private": false,
	"version": "0.11.0",
	"description": "Pure-protocol Kafka client, consumer/producer, and EOS patterns in TypeScript.",
	"type": "module",
	"main": "dist/index.cjs",
	"module": "dist/index.js",
	"types": "dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"license": "MIT",
	"keywords": [
		"kafka",
		"client",
		"producer",
		"consumer",
		"streaming",
		"typescript",
		"protocol"
	],
	"homepage": "https://chrisrecalis.github.io/kafkats",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/chrisrecalis/kafkats.git",
		"directory": "packages/client"
	},
	"bugs": {
		"url": "https://github.com/chrisrecalis/kafkats/issues"
	},
	"engines": {
		"node": ">=18"
	},
	"scripts": {
		"build": "pnpm clean && tsdown --config-loader native",
		"test": "vitest run --config vitest.unit.config.ts tests",
		"test:unit": "vitest run --config vitest.unit.config.ts tests/unit",
		"test:integration": "VITEST_INTEGRATION=1 vitest run --config vitest.integration.config.ts tests/integration",
		"typecheck": "tsc -p tsconfig.json --noEmit",
		"clean": "rm -rf dist",
		"benchmark:consumer": "tsx benchmarks/consumer-benchmark.ts",
		"prepack": "pnpm -w turbo run build --filter=$npm_package_name"
	},
	"devDependencies": {
		"@node-rs/crc32": "^1.10.6",
		"@testcontainers/kafka": "^11.8.1",
		"@types/node": "^24.10.1",
		"snappy": "7.3.3",
		"testcontainers": "^11.8.1",
		"tsdown": "^0.22.14",
		"tsx": "^4.20.6",
		"typescript": "^7.0.2",
		"vitest": "^4.0.12",
		"vitest-mock-extended": "^4.0.0"
	},
	"peerDependencies": {
		"@mongodb-js/zstd": ">=1.0.0",
		"@node-rs/crc32": "^1.10.6",
		"lz4": "^0.6.0",
		"lz4-napi": ">=2.0.0",
		"lz4js": "^0.2.0",
		"snappy": "^7.0.0",
		"snappyjs": ">=0.6.0 <1.0.0",
		"zstd-napi": ">=0.0.7 <0.1.0"
	},
	"peerDependenciesMeta": {
		"@mongodb-js/zstd": {
			"optional": true
		},
		"@node-rs/crc32": {
			"optional": true
		},
		"lz4": {
			"optional": true
		},
		"lz4-napi": {
			"optional": true
		},
		"lz4js": {
			"optional": true
		},
		"snappy": {
			"optional": true
		},
		"snappyjs": {
			"optional": true
		},
		"zstd-napi": {
			"optional": true
		}
	}
}
