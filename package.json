{
	"name": "kafkats-workspace",
	"private": true,
	"version": "0.0.0",
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@10.11.0",
	"scripts": {
		"build": "turbo run build",
		"clean": "turbo run clean",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"typecheck": "turbo run typecheck",
		"test": "turbo run test:unit",
		"test:unit": "turbo run test:unit",
		"test:integration": "turbo run test:integration",
		"format": "oxfmt packages",
		"format:check": "oxfmt --check packages",
		"docs:dev": "pnpm -C packages/docs dev",
		"docs:build": "pnpm -C packages/docs build",
		"docs:preview": "pnpm -C packages/docs preview",
		"version-packages": "changeset version",
		"release": "changeset publish"
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.8",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"turbo": "^2.7.2"
	}
}
